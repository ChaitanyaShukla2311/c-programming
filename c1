#include<stdio.h>
int main(){
    int n,ch,i,min,j,temp;
    printf("Enter size of array:");
    scanf("%d",&n);
    int a[n];
    printf("Enter array elements:");
    for(i=0;i<n;i++){
        scanf("%d",&a[i]);
    }
    printf("\n1.Selection Sort \n2.Bubble Sort \n Enter Choice:");
    scanf("%d",&ch);
    
    if(ch==1){
        for(i=0;i<n-1;i++){
            min = i;
            for(j=i+1;j<n;j++){
                if(a[j]<a[min]){
                    min = j;
                }
            }
            temp = a[i];
            a[i] = a[min];
            a[min] = temp;
        }
    }
    else if(ch==2){
        for(i=0;i<n-1;i++){
            for(j=0;j<n-i-1;j++){
                if(a[j]>a[j+1]){
                    temp=a[j];
                    a[j]= a[j+1];
                    a[j+1]=temp;
                }
            }
        }
    }
    else{
        printf("Invalide Choice");
    }
    
    printf("Sorted array :");
    for(i=0;i<n;i++){
        printf("%d",a[i]);
    }
    return 0;
}
